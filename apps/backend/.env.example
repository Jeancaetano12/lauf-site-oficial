# Configurações do Servidor NestJS
PORT=3000
NODE_ENV=development # Altere para 'production' na VPS

# Conexão com o Banco de Dados PostgreSQL (Prisma)
# Local: postgresql://admin:suasenhasupersecreta@localhost:5432/lauf_db?schema=public
DATABASE_URL="postgresql://admin:suasenhasupersecreta@localhost:5432/lauf_db?schema=public"

# URL Base do Frontend (usada pelo CORS e pelos links de ativação de conta por e-mail)
# Local: http://localhost:5173
# VPS (Produção): https://laufoficial.site
FRONTEND_URL=http://localhost:5173

# Autenticação e Criptografia (JWT)
# Gere chaves fortes e aleatórias (ex: openssl rand -base64 32)
JWT_SECRET="gere_um_segredo_jwt_longo_e_seguro"
JWT_REFRESH_SECRET="gere_um_segredo_refresh_longo_e_seguro"
DEVELOPER_BYPASS_TOKEN="token_opcional_de_bypass_desenvolvimento"

# Serviço de Envio de E-mails (SMTP Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu_email@gmail.com
EMAIL_PASS="sua_senha_de_aplicativo_google"
EMAIL_FROM="Equipe LAUF <seu_email@gmail.com>"
